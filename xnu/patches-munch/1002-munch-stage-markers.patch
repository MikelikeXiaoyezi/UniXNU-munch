 	ldr		x26, [x20, BA_BOOT_FLAGS]			// Get the kernel boot flags
 
+	/* MUNCH stage marker: 1003 1 MiB at framebuffer + 9c30 */
+	movz	x9, #0x9c30, lsl #16
+	mov	w10, #0x00ff
